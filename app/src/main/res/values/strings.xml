<resources>
    <!-- Default language: English. Turkish lives in values-tr/ and is used when the system language is Turkish. -->
    <string name="app_name" translatable="false">WhazzApp</string>

    <!-- Notification channels -->
    <string name="channel_service">Background connection</string>
    <string name="channel_messages">Messages · %1$s</string>

    <!-- Foreground service -->
    <string name="service_title">WhazzApp is running</string>
    <plurals name="service_text">
        <item quantity="one">Keeping %1$d account connected</item>
        <item quantity="other">Keeping %1$d accounts connected</item>
    </plurals>
    <string name="service_stop">Stop</string>

    <!-- Account strip -->
    <string name="account_default_name">Account %1$d</string>
    <string name="account_add">Add account</string>
    <string name="account_add_hint">Account name (e.g. Work, Personal)</string>
    <string name="account_add_info">The WhatsApp login screen will open for the new account. If you are on the same phone, use \"Log in with phone number\" instead of scanning the QR code.</string>
    <string name="account_rename">Rename</string>
    <string name="account_remove">Remove account</string>
    <string name="account_remove_confirm">Remove \"%1$s\" from this device? Its session data will be deleted. To also remove it from your Linked devices list, choose \"Log out\" in the WhatsApp menu first.</string>
    <string name="account_multi_unsupported">The WebView version on this device does not support multiple accounts. Update Android System WebView.</string>

    <!-- Menu -->
    <string name="menu">Menu</string>
    <string name="menu_battery">Turn off battery optimization</string>
    <string name="menu_stop">Stop background and exit</string>

    <string name="ok">OK</string>
    <string name="cancel">Cancel</string>
    <string name="remove">Remove</string>

    <string name="download_done">Downloaded: %1$s</string>
    <string name="download_failed">Download failed</string>
</resources>
